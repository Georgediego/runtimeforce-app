# RuntimeForce SaaS public signing-key endpoint.
# The IDE downloads and caches public JWKS; no SaaS signing secret is stored locally.
JWT_JWKS_URL=https://runtimeforce.dev/api/v1/auth/jwks.json

# Local encryption key used for stored provider/OAuth credentials.
MASTER_KEY=

# OAuth credentials (only required for the corresponding provider integrations).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/github/callback
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/x/callback
REDDIT_OAUTH_CLIENT_ID=
REDDIT_OAUTH_CLIENT_SECRET=
REDDIT_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/reddit/callback
REDDIT_USER_AGENT=RuntimeForce/1.0
