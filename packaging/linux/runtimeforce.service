[Unit]
Description=RuntimeForce IDE (per-user)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/usr/lib/runtimeforce
Environment=PYTHONPATH=/usr/lib/runtimeforce
Environment=PYTHONUNBUFFERED=1
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/python3.14 /usr/lib/runtimeforce/service_runner.py
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
